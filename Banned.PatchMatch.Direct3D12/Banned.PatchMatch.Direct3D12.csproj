<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IsAotCompatible>true</IsAotCompatible>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Banned.PatchMatch\Banned.PatchMatch.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Shaders\Downsample.dxil" />
		<EmbeddedResource Include="Shaders\FixedPointMaximize.dxil" />
		<EmbeddedResource Include="Shaders\FixedPointVote.dxil" />
		<EmbeddedResource Include="Shaders\NearestNeighborInitialization.dxil" />
		<EmbeddedResource Include="Shaders\NearestNeighborMinimization.dxil" />
		<EmbeddedResource Include="Shaders\PatchDistance.dxil" />
		<EmbeddedResource Include="Shaders\SquareDifference.dxil" />
		<EmbeddedResource Include="Shaders\SetIdentityLinks.dxil" />
		<EmbeddedResource Include="Shaders\UnpackRgb.dxil" />
		<EmbeddedResource Include="Shaders\UpsampleTarget.dxil" />
		<None Include="Shaders\Downsample.hlsl" />
		<None Include="Shaders\FixedPointMaximize.hlsl" />
		<None Include="Shaders\FixedPointVote.hlsl" />
		<None Include="Shaders\NearestNeighborInitialization.hlsl" />
		<None Include="Shaders\NearestNeighborMinimization.hlsl" />
		<None Include="Shaders\PatchDistance.hlsl" />
		<None Include="Shaders\SquareDifference.hlsl" />
		<None Include="Shaders\SetIdentityLinks.hlsl" />
		<None Include="Shaders\UnpackRgb.hlsl" />
		<None Include="Shaders\UpsampleTarget.hlsl" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Banned.PatchMatch.Direct3D12.AotSmoke" />
		<InternalsVisibleTo Include="Banned.PatchMatch.Direct3D12.Test" />
	</ItemGroup>

</Project>
